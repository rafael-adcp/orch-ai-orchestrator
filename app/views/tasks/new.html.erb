<div class="mx-auto max-w-2xl">
  <div class="mb-6">
    <h1 class="text-2xl font-semibold tracking-tight">New task</h1>
    <p class="mt-1 text-sm text-slate-500">Queue a Claude run against a local repository.</p>
  </div>

  <div class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
    <%= form_with model: @task, url: tasks_path, local: true, html: { class: "space-y-5" } do |f| %>
      <% if @task.errors.any? %>
        <div class="rounded-md border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-800">
          <p class="font-medium">Please fix the following:</p>
          <ul class="mt-1 list-disc pl-5">
            <% @task.errors.full_messages.each do |m| %><li><%= m %></li><% end %>
          </ul>
        </div>
      <% end %>

      <% input_classes = "mt-1 block w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm shadow-sm placeholder:text-slate-400 focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500" %>
      <% label_classes = "block text-sm font-medium text-slate-700" %>

      <div>
        <%= f.label :repo_path, class: label_classes %>
        <%= f.text_field :repo_path, class: "#{input_classes} font-mono", placeholder: "C:\\path\\to\\repo" %>
      </div>

      <div>
        <%= f.label :prompt, class: label_classes %>
        <%= f.text_area :prompt, rows: 6, class: input_classes, placeholder: "Describe the change you want Claude to make…" %>
      </div>

      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div>
          <%= f.label :model, class: label_classes %>
          <%= f.text_field :model, class: input_classes, placeholder: "sonnet" %>
        </div>
        <div>
          <%= f.label :effort, class: label_classes %>
          <%= f.text_field :effort, class: input_classes, placeholder: "max (sonnet) · xhigh (opus)" %>
        </div>
        <div class="sm:col-span-2">
          <%= f.label :docker_cmd, class: label_classes %>
          <%= f.text_field :docker_cmd, class: "#{input_classes} font-mono", placeholder: "optional: docker run --rm img" %>
        </div>
        <div>
          <div class="flex items-center gap-1">
            <%= f.label :priority, class: label_classes %>
            <span class="group relative inline-block cursor-help text-slate-400 hover:text-slate-600" tabindex="0">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"/><path d="M12 16v-4m0-4h.01"/>
              </svg>
              <span class="pointer-events-none absolute bottom-full left-1/2 z-10 mb-2 w-56 -translate-x-1/2 rounded bg-slate-800 px-3 py-2 text-xs text-white opacity-0 transition-opacity group-hover:opacity-100 group-focus:opacity-100">
                Higher number = runs first. Default is 0. Use a positive integer (e.g. 10) to jump the queue, or a negative one to defer low-urgency tasks.
              </span>
            </span>
          </div>
          <%= f.number_field :priority, value: @task.priority || 0, class: input_classes %>
        </div>
        <div>
          <%= f.label :recurring_interval_hours, "Repeat every (hours)", class: label_classes %>
          <%= f.number_field :recurring_interval_hours, class: input_classes, placeholder: "leave blank for one-shot", min: 1 %>
        </div>
      </div>

      <div class="flex items-center justify-end gap-3 border-t border-slate-100 pt-5">
        <%= link_to "Cancel", tasks_path,
              class: "rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50" %>
        <%= f.submit "Queue task",
              class: "rounded-md bg-slate-900 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-slate-700" %>
      </div>
    <% end %>
  </div>
</div>
