<div class="max-w-2xl mx-auto p-6">
  <h1 class="text-2xl font-semibold mb-4">New task</h1>

  <%= form_with model: @task, url: tasks_path, local: true, html: { class: "space-y-4" } do |f| %>
    <% if @task.errors.any? %>
      <div class="text-red-700 text-sm">
        <ul><% @task.errors.full_messages.each do |m| %><li><%= m %></li><% end %></ul>
      </div>
    <% end %>

    <div>
      <%= f.label :repo_path, class: "block text-sm font-medium" %>
      <%= f.text_field :repo_path, class: "w-full border rounded px-2 py-1 font-mono" %>
    </div>
    <div>
      <%= f.label :prompt, class: "block text-sm font-medium" %>
      <%= f.text_area :prompt, rows: 6, class: "w-full border rounded px-2 py-1" %>
    </div>
    <div class="grid grid-cols-2 gap-4">
      <div>
        <%= f.label :branch, class: "block text-sm font-medium" %>
        <%= f.text_field :branch, class: "w-full border rounded px-2 py-1" %>
      </div>
      <div>
        <%= f.label :model, class: "block text-sm font-medium" %>
        <%= f.text_field :model, class: "w-full border rounded px-2 py-1" %>
      </div>
      <div>
        <%= f.label :docker_cmd, class: "block text-sm font-medium" %>
        <%= f.text_field :docker_cmd, class: "w-full border rounded px-2 py-1 font-mono" %>
      </div>
      <div>
        <%= f.label :priority, class: "block text-sm font-medium" %>
        <%= f.number_field :priority, value: @task.priority || 0, class: "w-full border rounded px-2 py-1" %>
      </div>
    </div>

    <%= f.submit "Queue task", class: "px-4 py-2 bg-black text-white rounded" %>
  <% end %>
</div>
