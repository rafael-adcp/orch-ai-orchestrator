<div id="tasks-list" class="overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm">
  <% if @tasks.empty? %>
    <div class="px-6 py-16 text-center">
      <p class="text-sm font-medium text-slate-900">No tasks yet</p>
      <p class="mt-1 text-sm text-slate-500">Queue your first run to see it appear here.</p>
      <%= link_to "New task", new_task_path,
            class: "mt-4 inline-flex rounded-md bg-slate-900 px-3 py-2 text-sm font-medium text-white hover:bg-slate-700" %>
    </div>
  <% else %>
    <table class="w-full table-fixed divide-y divide-slate-200 text-sm">
      <thead class="bg-slate-50 text-xs font-medium uppercase tracking-wide text-slate-500">
        <tr>
          <th class="px-4 py-3 text-left w-20">ID</th>
          <th class="px-4 py-3 text-left w-36 whitespace-nowrap">Status</th>
          <th class="px-4 py-3 text-left w-1/4">Repo</th>
          <th class="px-4 py-3 text-left">Prompt</th>
          <th class="px-4 py-3 text-left w-32">Created</th>
          <th class="px-4 py-3 w-48"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% @tasks.each do |t| %>
          <tr id="<%= dom_id(t) %>" class="hover:bg-slate-50 cursor-pointer group" onclick="location.href='<%= task_path(t) %>'">
            <td class="px-4 py-3 font-mono text-xs text-slate-900"><%= t.id %></td>
            <td class="px-4 py-3 whitespace-nowrap"><%= status_badge(t.status) %></td>
            <td class="px-4 py-3 font-mono text-xs text-slate-600 truncate"><%= t.repo_path %></td>
            <td class="px-4 py-3 text-slate-700 truncate"><%= t.prompt %></td>
            <td class="px-4 py-3 text-slate-500 whitespace-nowrap"><%= t.created_at ? content_tag(:time, t.created_at.to_fs(:short), datetime: t.created_at.iso8601, data: { local: true }) : "" %></td>
            <td class="px-4 py-3 text-right" onclick="event.stopPropagation()">
              <span class="inline-flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
                <%= link_to "Copy", new_task_path(ai_task: { repo_path: t.repo_path, prompt: t.prompt, model: t.model, docker_cmd: t.docker_cmd, priority: t.priority }),
                      class: "rounded px-2 py-1 text-xs font-medium bg-slate-100 hover:bg-slate-200 text-slate-600" %>
                <%= button_to "Retry", retry_task_path(t), method: :post,
                      form: { class: "inline", data: { turbo_confirm: "Retry task #{t.id}?" } },
                      class: "rounded px-2 py-1 text-xs font-medium bg-sky-100 hover:bg-sky-200 text-sky-700" %>
                <%= button_to "Delete", task_path(t), method: :delete,
                      form: { class: "inline", data: { turbo_confirm: "Delete task #{t.id}?" } },
                      class: "rounded px-2 py-1 text-xs font-medium bg-rose-100 hover:bg-rose-200 text-rose-700" %>
              </span>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <% if @page > 1 || @has_next %>
      <div class="flex items-center justify-between border-t border-slate-200 px-4 py-3">
        <div>
          <% if @page > 1 %>
            <%= link_to "← Previous", tasks_path(page: @page - 1),
                  class: "rounded px-3 py-1 text-sm font-medium text-slate-700 hover:bg-slate-100" %>
          <% end %>
        </div>
        <span class="text-xs text-slate-500">Page <%= @page %></span>
        <div>
          <% if @has_next %>
            <%= link_to "Next →", tasks_path(page: @page + 1),
                  class: "rounded px-3 py-1 text-sm font-medium text-slate-700 hover:bg-slate-100" %>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
