<% status = @task.status %>
<div class="mb-6 flex items-start justify-between gap-4">
  <div>
    <p class="text-xs font-medium uppercase tracking-wide text-slate-500">Task</p>
    <h1 class="mt-1 flex items-center gap-3 text-2xl font-semibold tracking-tight">
      <span class="font-mono"><%= @task.id %></span>
      <%= status_badge(status) %>
    </h1>
  </div>
  <div class="flex items-center gap-2">
    <%= link_to "View log", log_task_path(@task),
          class: "rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50" %>
    <%= link_to "Copy", new_task_path(ai_task: { repo_path: @task.repo_path, prompt: @task.prompt, model: @task.model, docker_cmd: @task.docker_cmd, priority: @task.priority }),
          class: "rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50" %>
    <% if status.retryable? %>
      <%= button_to "Retry", retry_task_path(@task), method: :post,
            form: { class: "inline", data: { turbo_confirm: "Retry task #{@task.id}?" } },
            class: "rounded-md bg-slate-900 px-3 py-1.5 text-sm font-medium text-white hover:bg-slate-700" %>
    <% end %>
    <% if status.cancellable? %>
      <%= button_to "Cancel", cancel_task_path(@task), method: :post,
            form: { class: "inline", data: { turbo_confirm: "Cancel task #{@task.id}? This will stop the running job." } },
            class: "rounded-md bg-rose-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-rose-700" %>
    <% end %>
    <% if status.running? %>
      <button type="button" disabled
              title="Cancel the task before deleting it."
              class="cursor-not-allowed rounded-md bg-rose-300 px-3 py-1.5 text-sm font-medium text-white">
        Delete
      </button>
    <% else %>
      <%= button_to "Delete", task_path(@task), method: :delete,
            form: { class: "inline", data: { turbo_confirm: "Delete task #{@task.id} and its log file? This cannot be undone." } },
            class: "rounded-md bg-rose-700 px-3 py-1.5 text-sm font-medium text-white hover:bg-rose-800" %>
    <% end %>
  </div>
</div>

<div class="overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm">
  <dl class="divide-y divide-slate-100 text-sm">
    <% [
         [ "Repo",     content_tag(:span, @task.repo_path, class: "font-mono break-all") ],
         [ "Prompt",   content_tag(:p, @task.prompt, class: "whitespace-pre-wrap text-slate-800") ],
         [ "Model",    @task.model.presence  || content_tag(:span, ClaudeCommand::DEFAULT_MODEL, class: "text-slate-400") ],
         [ "Started",  @task.started_at  ? content_tag(:time, l(@task.started_at, format: :short), datetime: @task.started_at.iso8601, data: { local: true }) : content_tag(:span, "—", class: "text-slate-400") ],
         [ "Finished", @task.finished_at ? content_tag(:time, l(@task.finished_at, format: :short), datetime: @task.finished_at.iso8601, data: { local: true }) : content_tag(:span, "—", class: "text-slate-400") ],
         [ "Attempts", status.attempts ],
         [ "Next retry at", status.next_retry_at ? content_tag(:time, l(status.next_retry_at, format: :short), datetime: status.next_retry_at.iso8601, data: { local: true }) : content_tag(:span, "—", class: "text-slate-400") ]
       ].each do |label, value| %>
      <div class="grid grid-cols-[10rem_1fr] gap-4 px-6 py-3">
        <dt class="text-slate-500"><%= label %></dt>
        <dd class="text-slate-900"><%= value %></dd>
      </div>
    <% end %>
  </dl>
</div>

<% if @task.error.present? %>
  <div class="mt-6 rounded-lg border border-rose-200 bg-rose-50 p-4">
    <p class="text-sm font-medium text-rose-900">Error</p>
    <p class="mt-1 whitespace-pre-wrap text-sm text-rose-800"><%= @task.error %></p>
  </div>
<% end %>

<div class="mt-6">
  <p class="mb-2 text-xs font-medium uppercase tracking-wide text-slate-500">Log</p>
  <pre class="overflow-auto rounded-lg border border-slate-200 bg-slate-950 p-4 text-xs leading-relaxed text-slate-100 whitespace-pre-wrap break-all" style="max-height:60vh"><%= @task.log_text.presence || "(no log yet)" %></pre>
</div>
