<% purge_age   = TaskPurge.default_age %>
<% purge_label = distance_of_time_in_words(purge_age) %>
<div class="mb-6 flex items-end justify-between">
  <div>
    <h1 class="text-2xl font-semibold tracking-tight">Tasks</h1>
  </div>
  <div class="flex items-center gap-2">
    <%= button_to "Purge older than #{purge_label}", purge_tasks_path, method: :post,
          form: { class: "inline", data: { turbo_confirm: "Permanently delete all tasks finished more than #{purge_label} ago, including their logs?" } },
          class: "rounded-md border border-rose-300 bg-white px-3 py-2 text-sm font-medium text-rose-700 hover:bg-slate-50" %>
    <%= link_to "New task", new_task_path,
          class: "rounded-md bg-slate-900 px-3 py-2 text-sm font-medium text-white shadow-sm hover:bg-slate-700" %>
  </div>
</div>

<%= render 'status_diagram' %>

<%= render 'tasks_list' %>
