<details class="group mb-4 overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm">
  <summary class="flex cursor-pointer select-none items-center justify-between px-4 py-3 text-sm font-medium text-slate-700 hover:bg-slate-50">
    Status transitions
    <svg class="h-4 w-4 text-slate-400 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
    </svg>
  </summary>
  <div class="border-t border-slate-100 px-6 py-5">
    <svg viewBox="0 0 660 270" xmlns="http://www.w3.org/2000/svg" class="w-full" style="max-height:270px" aria-label="Task status transition diagram">
      <defs>
        <marker id="arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 0 L 10 5 L 0 10 z" fill="#94a3b8"/>
        </marker>
        <marker id="arr-retry" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 0 L 10 5 L 0 10 z" fill="#6366f1"/>
        </marker>
      </defs>

      <!-- new task indicator -->
      <circle cx="18" cy="80" r="5" fill="#94a3b8"/>
      <line x1="23" y1="80" x2="48" y2="80" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#arr)"/>
      <text x="18" y="64" text-anchor="middle" font-size="9" fill="#94a3b8">new</text>

      <!-- queued → running -->
      <line x1="152" y1="80" x2="238" y2="80" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#arr)"/>

      <!-- running → done -->
      <line x1="341" y1="75" x2="469" y2="45" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#arr)"/>

      <!-- running → failed -->
      <line x1="341" y1="82" x2="469" y2="98" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#arr)"/>

      <!-- running → needs_review -->
      <line x1="339" y1="87" x2="459" y2="155" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#arr)"/>

      <!-- running → blocked -->
      <line x1="337" y1="91" x2="469" y2="213" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#arr)"/>

      <!-- running ↓ retrying (right side of running box) -->
      <path d="M 330 94 Q 370 145 330 184" fill="none" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#arr)"/>

      <!-- retrying ↑ running (SQ fires retry automatically — dashed) -->
      <path d="M 250 186 Q 210 145 250 94" fill="none" stroke="#94a3b8" stroke-width="1.5" stroke-dasharray="4,2" marker-end="url(#arr)"/>

      <!-- queued ↓ cancelled -->
      <line x1="100" y1="94" x2="100" y2="184" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#arr)"/>

      <!-- retrying → cancelled -->
      <line x1="240" y1="200" x2="152" y2="200" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#arr)"/>

      <!-- Retry arc: terminal nodes → vertical bus at x=585 → bottom rail → back to queued -->
      <line x1="561" y1="40"  x2="585" y2="40"  stroke="#6366f1" stroke-width="1"   stroke-dasharray="3,2"/>
      <line x1="561" y1="100" x2="585" y2="100" stroke="#6366f1" stroke-width="1"   stroke-dasharray="3,2"/>
      <line x1="571" y1="160" x2="585" y2="160" stroke="#6366f1" stroke-width="1"   stroke-dasharray="3,2"/>
      <line x1="561" y1="220" x2="585" y2="220" stroke="#6366f1" stroke-width="1"   stroke-dasharray="3,2"/>
      <line x1="585" y1="40"  x2="585" y2="250" stroke="#6366f1" stroke-width="1.5" stroke-dasharray="4,2"/>
      <line x1="585" y1="250" x2="30"  y2="250" stroke="#6366f1" stroke-width="1.5" stroke-dasharray="4,2"/>
      <line x1="30"  y1="250" x2="30"  y2="84"  stroke="#6366f1" stroke-width="1.5" stroke-dasharray="4,2"/>
      <line x1="30"  y1="84"  x2="48"  y2="84"  stroke="#6366f1" stroke-width="1.5" stroke-dasharray="4,2" marker-end="url(#arr-retry)"/>
      <!-- cancelled → bottom rail (cancelled is also retryable) -->
      <line x1="100" y1="214" x2="100" y2="250" stroke="#6366f1" stroke-width="1"   stroke-dasharray="3,2"/>

      <!-- Arrow labels -->
      <text x="89"  y="143" text-anchor="middle" font-size="9" fill="#64748b">cancel</text>
      <text x="195" y="194" text-anchor="middle" font-size="9" fill="#64748b">cancel</text>
      <text x="306" y="246" text-anchor="middle" font-size="9" fill="#6366f1">retry</text>

      <!-- ── Nodes ───────────────────────────────────────────────── -->

      <!-- queued (amber) -->
      <rect x="50" y="66" width="100" height="28" rx="4" fill="#fffbeb" stroke="#fde68a" stroke-width="1.5"/>
      <text x="100" y="84" text-anchor="middle" font-size="11" font-weight="500" fill="#92400e">queued</text>

      <!-- running (blue) -->
      <rect x="240" y="66" width="100" height="28" rx="4" fill="#eff6ff" stroke="#bfdbfe" stroke-width="1.5"/>
      <text x="290" y="84" text-anchor="middle" font-size="11" font-weight="500" fill="#1e40af">running</text>

      <!-- done (emerald) -->
      <rect x="470" y="26" width="90" height="28" rx="4" fill="#ecfdf5" stroke="#a7f3d0" stroke-width="1.5"/>
      <text x="515" y="44" text-anchor="middle" font-size="11" font-weight="500" fill="#065f46">done</text>

      <!-- failed (rose) -->
      <rect x="470" y="86" width="90" height="28" rx="4" fill="#fff1f2" stroke="#fecdd3" stroke-width="1.5"/>
      <text x="515" y="104" text-anchor="middle" font-size="11" font-weight="500" fill="#9f1239">failed</text>

      <!-- needs_review (yellow) -->
      <rect x="460" y="146" width="110" height="28" rx="4" fill="#fefce8" stroke="#fef08a" stroke-width="1.5"/>
      <text x="515" y="164" text-anchor="middle" font-size="11" font-weight="500" fill="#713f12">needs review</text>

      <!-- blocked (rose) -->
      <rect x="470" y="206" width="90" height="28" rx="4" fill="#fff1f2" stroke="#fecdd3" stroke-width="1.5"/>
      <text x="515" y="224" text-anchor="middle" font-size="11" font-weight="500" fill="#9f1239">blocked</text>

      <!-- retrying (indigo) -->
      <rect x="240" y="186" width="100" height="28" rx="4" fill="#eef2ff" stroke="#c7d2fe" stroke-width="1.5"/>
      <text x="290" y="204" text-anchor="middle" font-size="11" font-weight="500" fill="#3730a3">retrying</text>

      <!-- cancelled (slate) -->
      <rect x="50" y="186" width="100" height="28" rx="4" fill="#f1f5f9" stroke="#e2e8f0" stroke-width="1.5"/>
      <text x="100" y="204" text-anchor="middle" font-size="11" font-weight="500" fill="#334155">cancelled</text>
    </svg>
    <p class="mt-2 text-xs text-slate-400">
      Dashed lines are automatic (Solid Queue-driven).
      <span class="text-indigo-400">Indigo</span> path is the user-triggered retry action (all terminal states including cancelled).
    </p>
  </div>
</details>
